# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web

# SQLite path (inside container use /app/data/db.sqlite3)
DATABASE_PATH=db.sqlite3

# Celery / Redis (service name `redis` in docker-compose)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# OpenAI (optional — without key FakeLLMClient is used)
OPENAI_API_KEY=

# Local Redis URL (when running Django/Celery outside Docker)
REDIS_URL=redis://localhost:6379/0
